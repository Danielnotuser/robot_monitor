<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <right_joint>right_wheel_joint</right_joint>
            <left_joint>left_wheel_joint</left_joint>
            <wheel_separation>0.35</wheel_separation>
            <wheel_radius>0.05</wheel_radius>
            <max_linear_acceleration>10</max_linear_acceleration>
            <topic>cmd_vel</topic>
        </plugin>

        <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
            <odom_frame>odom</odom_frame>
            <robot_base_frame>base_link</robot_base_frame>
            <odom_publish_frequency>50</odom_publish_frequency>
            <odom_topic>odom</odom_topic>
            <tf_topic>tf</tf_topic>
            <dimensions>2</dimensions>
        </plugin>

        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
            <joint_name>right_wheel_joint</joint_name>
            <joint_name>left_wheel_joint</joint_name>
        </plugin>
    </gazebo>

    <!-- RGBD Camera (depth + color) -->
    <gazebo reference="camera_frame">
        <sensor type="depth" name="depth_sensor">
            <pose>0 0 0 0 0 0</pose>
            <visualize>true</visualize>
            <update_rate>10.0</update_rate>
            <camera>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R_FLOAT32</format>
                </image>
                <clip>
                    <near>0.2</near>
                    <far>30.0</far>
                </clip>
                <horizontal_fov>1.047</horizontal_fov> <!-- 60 градусов -->
                <vertical_fov>0.785</vertical_fov>    <!-- 45 градусов -->
            </camera>
            <topic>camera/depth/image_raw</topic>
            <frame_name>camera_depth_frame</frame_name>
            <output_type>image</output_type>
        </sensor>

        <sensor type="camera" name="color_sensor">
            <pose>0 0 0 0 0 0</pose>
            <visualize>true</visualize>
            <update_rate>10.0</update_rate>
            <camera>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>RGB_INT8</format>
                </image>
                <clip>
                    <near>0.2</near>
                    <far>30.0</far>
                </clip>
                <horizontal_fov>1.047</horizontal_fov>
                <vertical_fov>0.785</vertical_fov>
            </camera>
            <topic>camera/color/image_raw</topic>
            <frame_name>camera_color_frame</frame_name>
        </sensor>
    </gazebo>
</robot>